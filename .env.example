# ─────────────────────────────────────────
# ASANA CONFIGURATION
# ─────────────────────────────────────────
ASANA_TOKEN=your_asana_personal_access_token_here

# Workspace GID
ASANA_WORKSPACE_GID=41261904390129

# Team GID — scope project discovery to one team (recommended)
# The Creative Foundry: 1211868948534506
ASANA_TEAM_GID=1211868948534506

# Projects: leave blank to auto-discover all projects in the team
# Or provide a comma-separated list to limit scope further
# ASANA_PROJECT_GIDS=1212446476552317,another_gid

# ── Confirmed custom field GIDs (do not change) ──────────
# "Estimated time" (number, hours)
ASANA_FIELD_ESTIMATED_TIME=1203387567618671

# "Average Minute Rate (XCF)" (number, $/min — default 2.33 NZD)
ASANA_FIELD_MINUTE_RATE=1213826548214530

# "Asset count (XCF)" (number)
ASANA_FIELD_ASSET_COUNT=1212213385632145

# "XCF: Asset cost" (number — pre-calculated field, read-only)
ASANA_FIELD_ASSET_COST=1213828392202051

# ── Rate constants ────────────────────────────────────────
# $2.33 NZD/min = $139.80/hr ≈ $150/hr global average
DEFAULT_MINUTE_RATE=2.33
WORKING_HOURS_PER_DAY=8

# ─────────────────────────────────────────
# SLACK CONFIGURATION
# ─────────────────────────────────────────
SLACK_TOKEN=xoxb-your-slack-bot-token-here
SLACK_CHANNEL_ID=your_slack_channel_id_here

# ─────────────────────────────────────────
# REPORT SETTINGS
# ─────────────────────────────────────────
REPORTS_DIR=reports
